# Deny by default; only reviewed source and required UI inputs enter Git.
*
!/.gitignore
!/README.md
!/LICENSE
!/CMakeLists.txt

!/src/
!/src/**/
!/src/**/*.cpp
!/src/**/*.hpp
!/src/shaders/vulkan/*.vert
!/src/shaders/vulkan/*.frag
!/src/shaders/vulkan/*.glsl

!/checks/
!/checks/*.cpp
!/checks/game_cli.py

!/cmake/
!/cmake/embed_spirv.cmake

!/packaging/
!/packaging/build_appimage.py
!/packaging/license_bundle.py
!/packaging/check_packaging.py
!/packaging/pusu.desktop
!/packaging/public-provenance.json
!/packaging/licenses/
!/packaging/licenses/pusu-native/
!/packaging/licenses/pusu-native/public-build.json
!/packaging/licenses/dbus/
!/packaging/licenses/dbus/build-owned-client.py
!/packaging/licenses/libgcc/
!/packaging/licenses/libgcc/rebuild-runtime.sh
!/packaging/licenses/libgcc/runtime-libdir.patch
!/packaging/sources/
!/packaging/sources/public-runtime/
!/packaging/sources/public-runtime/build.sh
!/packaging/sources/public-runtime/build-gcab.sh
!/packaging/sources/public-runtime/runtime-portable-path.patch
!/packaging/sources/public-runtime/runtime-includes.patch
!/packaging/sources/public-runtime/libfuse-modification-notice.patch
!/packaging/art/
!/packaging/art/installer.png
!/packaging/art/pusu.png
!/packaging/art/NOTICE.txt
!/packaging/art/provenance.json

# Never admit private work, caches or compiled Python, even inside source trees.
**/.work/
**/.cache/
**/__pycache__/
*.py[cod]
# Only the reviewed public provenance and authored rebuild controls above enter Git.
# Bulk upstream source/notices/relink evidence stays in matched release companions;
# packaging/provenance.json and all unlisted machine-private evidence remain excluded.
